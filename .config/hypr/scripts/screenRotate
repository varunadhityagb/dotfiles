#!/bin/bash

MONITORS=("HDMI-A-1" "eDP-1")
monitor_index=$1
device_name=${MONITORS[$monitor_index]}
STATE_FILE="$HOME/.config/hypr/state.lua"

if [ -z "$device_name" ]; then
    echo "Usage: $0 <0|1>  (0=HDMI-A-1, 1=eDP-1)"
    exit 1
fi

# Read current transform
current=$(grep -A3 "\"${device_name}\"" "$STATE_FILE" | grep -oP "transform\s*=\s*\K[0-9]+")
current=${current:-0}

case $current in
0) next=1 ;; 1) next=2 ;; 2) next=3 ;; 3) next=0 ;; *) next=0 ;;
esac

# Patch transform inside the monitor's block
# Uses awk to only change the line after the device name is seen
awk -v dev="$device_name" -v new_transform="$next" '
    found && /transform/ { sub(/transform *= *[0-9]+/, "transform = " new_transform); found=0 }
    /\[\"/ { found=0 }
    $0 ~ "\"" dev "\"" { found=1 }
    { print }
' "$STATE_FILE" >/tmp/state_tmp.lua && mv /tmp/state_tmp.lua "$STATE_FILE"

echo "Rotated $device_name: $current → $next"
hyprctl reload
